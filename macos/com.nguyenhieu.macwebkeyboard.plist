<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- File mẫu tham khảo; chạy ./macos/install_launchd.sh để tự động điền đường dẫn thực tế trên MacBook M3 Pro -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nguyenhieu.macwebkeyboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PYTHON__</string>
        <string>__SERVER_PY__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/mac-web-keyboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/mac-web-keyboard.err.log</string>
</dict>
</plist>
